# Production environment for backend/.env — copy, fill in, keep OUT of git.
APP_NAME="Enterprise ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_VERSION=1.0.0

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Frontend origin / cookies
FRONTEND_URL=https://erp.example.com
CORS_ALLOWED_ORIGINS=https://erp.example.com
SANCTUM_STATEFUL_DOMAINS=erp.example.com
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
AUTH_PASSWORD_TIMEOUT=900

# Database (managed MySQL with TLS)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp_app
DB_PASSWORD=
DB_SSL_CA=storage/certs/ca.pem
DB_SSL_VERIFY=true

# Queue / cache
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail (password resets, invitations, notifications)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Files
FILESYSTEM_DISK=local
ERP_UPLOAD_MAX_KB=10240

# One-time bootstrap of the first administrator, then set back to false
ERP_ALLOW_ADMIN_BOOTSTRAP=false

# Retention (days)
ERP_RETAIN_AUDIT_DAYS=730
ERP_RETAIN_NOTIFICATIONS_DAYS=90
ERP_RETAIN_EXPORTS_DAYS=7
ERP_EXPORT_SYNC_ROWS=2000
